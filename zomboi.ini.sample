[bot]
# Your discord bot token - taken from the discord developer portal after creating your bot
token = 

# These channels all require ID's, in discord right click and copy a link to a channel, the ID will be on the end e.g. https://discord.com/channels/<server_id>/<channel_id>
# User notifications
users channel = 
# Chat mirroring (one way from game to discord)
chat channel = 
# Skill notifications
skill channel =

[server]
# Optional, where the server is installed. Leave blank to use a "server" folder next to the bot,
# then steam's default location. See the readme.
path =

# Optional, what the server calls itself, which decides which config file in Zomboid/Server the bot
# reads and writes. Leave blank for the game's default of "servertest".
name =